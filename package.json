{
  "name": "swagger-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "agent:poc": "tsx --tsconfig local-agent/tsconfig.json local-agent/strands-agent.ts",
    "agent:server": "tsx --tsconfig local-agent/tsconfig.json local-agent/server.ts",
    "agent:restart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/restart-agent.ps1",
    "agent:restart:bg": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/restart-agent.ps1 -Background",
    "agent:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/restart-agent.ps1 -StopOnly",
    "agent:check": "tsc -p local-agent/tsconfig.json --noEmit",
    "agent:test:browser-session": "tsx --tsconfig local-agent/tsconfig.json scripts/test-browser-session.ts",
    "agent:test:tool-retrieval": "tsx --tsconfig local-agent/tsconfig.json scripts/test-tool-retrieval.ts",
    "smoke:connections": "node scripts/smoke-connections.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@playwright/mcp": "0.0.78",
    "@strands-agents/sdk": "^1.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.441.0",
    "openai": "^6.45.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "tailwind-merge": "^2.5.2",
    "zod": "^4.4.3",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.44",
    "playwright": "1.62.0-alpha-1783623505000",
    "tailwindcss": "^3.4.11",
    "tsx": "^4.23.0",
    "typescript": "^5.5.4",
    "vite": "^8.1.0"
  }
}
